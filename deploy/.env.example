# Copy to deploy/.env and fill in. deploy/.env is gitignored.

# Domain pointing (DNS A record) to the Lightsail static IP
DOMAIN=share.example.com

# Lightsail static IP, and the instance's private IP (run: hostname -I | awk '{print $1}')
PUBLIC_IP=203.0.113.10
PRIVATE_IP=172.26.0.10

# TURN login. Use letters and digits only, e.g. generate with: openssl rand -hex 24
TURN_USER=nearshare
TURN_PASSWORD=change-me

# UDP relay port range, must match the Lightsail firewall rule
TURN_MIN_PORT=49152
TURN_MAX_PORT=49999
